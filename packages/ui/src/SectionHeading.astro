---
interface Props { title: string; aside?: string; number?: string; href?: string; linkLabel?: string; id?: string; }
const { title, aside, number, href, linkLabel, id } = Astro.props;
---
<div class="section-heading" id={id}>
  <h2>{title}{aside && <em>{aside}</em>}</h2>
  {(number || href) && <span class="tag dim">{number && <>§ {number} {href && '— '}</>}{href && <a href={href}>[ {linkLabel ?? 'view all'} → ]</a>}</span>}
</div>
<div class="rule" aria-hidden="true"></div>
<style>
  .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); margin-top: var(--section); flex-wrap: wrap; }
  h2 { font: 400 var(--t3)/1.1 'Redaction', Georgia, serif; margin: 0; }
  h2 em { font: italic var(--t2)/1.1 'Redaction 35', Georgia, serif; color: var(--dim); margin-left: .4em; }
  a { color: var(--fg); }
</style>
