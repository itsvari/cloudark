---
import type { ActivityItem, Site } from "@itsvari/content";
import { formatDate } from "./index";

interface Props {
  currentSite: Site;
  items: ActivityItem[];
}

const { currentSite, items } = Astro.props;
---

<ol class="activity-list">
  {items.map((item) => (
    <li>
      <div class="meta">
        <span>{item.kind}</span>
        {item.eventPhase && <span>{item.eventPhase}</span>}
        <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
      </div>
      <h3><a href={item.href}>{item.title}</a></h3>
      <p>{item.summary}</p>
      {item.canonicalSite !== currentSite && (
        <small>From {item.canonicalSite === "itsvari" ? "itsvari.com" : "v4ri.xyz"}</small>
      )}
    </li>
  ))}
</ol>

<style>
  .activity-list {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .activity-list li {
    border-top: 1px solid currentColor;
    padding-top: 1rem;
  }

  .activity-list h3,
  .activity-list p {
    margin-block: 0.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
</style>
