---
import type { ContentImage } from '@itsvari/content';
interface Props { image?: ContentImage; placeholder?: 'p1' | 'p2' | 'p3' | 'p4' | 'p5'; }
const { image, placeholder = 'p1' } = Astro.props;
---
<div class:list={['photo-fill', { [placeholder]: !image }]} aria-hidden="true">
  {image && <img src={image.src} alt="" loading="lazy" decoding="async" />}
</div>
<div class="photo-text-shade" aria-hidden="true"></div>
<style>
  .photo-fill { position: absolute; inset: 0 0 1px; z-index: -2; background-size: cover; background-position: center; filter: grayscale(1); transition: filter .35s; mask-image: linear-gradient(90deg, transparent 40%, #000 84%); mask-size: 100% 100%; mask-repeat: repeat-y; -webkit-mask-image: linear-gradient(90deg, transparent 40%, #000 84%); -webkit-mask-size: 100% 100%; -webkit-mask-repeat: repeat-y; pointer-events: none; }
  .photo-fill img { width: 100%; height: 100%; object-fit: cover; }
  .photo-fill::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,.45); }
  .photo-text-shade { position: absolute; inset: 0 0 1px; z-index: -1; background: rgba(0,0,0,.18); pointer-events: none; }
</style>
<script>
  import { photoMaskGeometry, photoMaskSvg } from './photo-mask';

  function textEndPositionPx(row: HTMLElement, photo: HTMLElement): number | undefined {
    const photoBounds = photo.getBoundingClientRect();
    const textBounds = [...row.querySelectorAll('[data-photo-text]')].flatMap((element) => {
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
      const rectangles: DOMRect[] = [];
      let textNode = walker.nextNode();
      while (textNode) {
        const range = document.createRange();
        range.selectNodeContents(textNode);
        rectangles.push(...range.getClientRects());
        textNode = walker.nextNode();
      }
      return rectangles.filter((rectangle) => rectangle.width > 0 && rectangle.height > 0);
    });
    if (textBounds.length === 0) return undefined;
    return Math.max(...textBounds.map((rectangle) => rectangle.right - photoBounds.left));
  }

  function updatePhotoMask(photo: HTMLElement): void {
    const row = photo.closest('[data-photo-row], .hasbg');
    if (!(row instanceof HTMLElement)) return;
    const widthPx = photo.getBoundingClientRect().width;
    if (widthPx <= 0) return;
    const geometry = photoMaskGeometry({ widthPx, textEndPx: textEndPositionPx(row, photo) });
    photo.style.setProperty('--photo-fade-start', `${geometry.fadeStartPx}px`);
    photo.style.setProperty('--photo-fade-width', `${geometry.fadeWidthPx}px`);
    const mask = `url("data:image/svg+xml,${encodeURIComponent(photoMaskSvg(geometry))}")`;
    const maskSize = `${geometry.widthPx}px ${geometry.tileHeightPx}px`;
    photo.style.maskImage = mask;
    photo.style.webkitMaskImage = mask;
    photo.style.maskSize = maskSize;
    photo.style.webkitMaskSize = maskSize;
  }

  const photos = [...document.querySelectorAll<HTMLElement>('.photo-fill')];
  let pendingFrame = 0;
  function schedulePhotoMasks(): void {
    if (pendingFrame) return;
    pendingFrame = requestAnimationFrame(() => {
      photos.forEach(updatePhotoMask);
      pendingFrame = 0;
    });
  }
  const resizeObserver = new ResizeObserver(schedulePhotoMasks);
  photos.forEach((photo) => {
    resizeObserver.observe(photo);
    const row = photo.closest('[data-photo-row], .hasbg');
    if (row) resizeObserver.observe(row);
  });
  schedulePhotoMasks();
  document.fonts.ready.then(schedulePhotoMasks);
  document.fonts.addEventListener('loadingdone', schedulePhotoMasks);
  window.addEventListener('resize', schedulePhotoMasks, { passive: true });

  document.addEventListener('click', (event) => {
    if (!(event instanceof PointerEvent) || event.pointerType !== 'touch') return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest('a[data-photo-link]');
    const row = link?.closest('[data-photo-row]');
    if (!row || row.classList.contains('is-active')) return;
    event.preventDefault();
    document.querySelectorAll('[data-photo-row].is-active').forEach((activeRow) => activeRow.classList.remove('is-active'));
    row.classList.add('is-active');
  });
</script>
