{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "v4ri-music",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "routes": [
    {
      "pattern": "v4ri.wav",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
