---
import { getPosts } from "@itsvari/content/astro";
import { contentPath } from "@itsvari/content";
import EmptyState from "@itsvari/ui/EmptyState.astro";
import LedgerTable from "@itsvari/ui/LedgerTable.astro";
import LedgerRow from "@itsvari/ui/LedgerRow.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts = await getPosts("v4ri");
---

<SiteLayout description="Notes on music, records and the dancefloor from V4RI." title="Posts">
  <header class="v-head"><div><div class="tag dim">§ 03 — posts · {String(posts.length).padStart(2, "0")} entries</div><h1>Posts <em>from the booth</em></h1></div><p>Notes on music and production.</p></header>
  <div class="page-rule" aria-hidden="true"></div>
  {posts.length > 0 ? <LedgerTable variant="content" titleLabel="Post">
    {posts.map((post) => <LedgerRow href={post.data.canonicalSite === "v4ri" ? contentPath("post", post.id, "v4ri") : `https://itsvari.com${contentPath("post", post.id, "itsvari")}`} title={post.data.title} date={post.data.publishedAt} kind={post.data.kind} image={post.data.image} />)}
  </LedgerTable> : <EmptyState message="No posts published." />}
</SiteLayout>
