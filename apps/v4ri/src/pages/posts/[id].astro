---
import { getPost } from "@itsvari/content/astro";
import { canonicalUrl } from "@itsvari/content";
import { formatDate } from "@itsvari/ui";
import { render } from "astro:content";
import ReadingArticle from "../../components/ReadingArticle.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const id = Astro.params.id;
const post = id ? await getPost(id, "v4ri") : undefined;
if (!post) return Astro.rewrite("/404");
const { Content, headings } = await render(post);
---

<SiteLayout canonical={canonicalUrl("post", post.id, post.data.canonicalSite)} description={post.data.summary} title={post.data.title}>
  <ReadingArticle title={post.data.title} summary={post.data.summary} headings={headings}>
    <Fragment slot="meta"><a href="/posts">[ posts → ]</a><span>[ {post.data.kind} ]</span><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>{post.data.tags.map((tag) => <span>[ {tag} ]</span>)}</Fragment>
    <Content />
    <a class="back-link tag" href="/posts">[ all posts → ]</a>
  </ReadingArticle>
</SiteLayout>
