---
import SiteLayout from "../layouts/SiteLayout.astro";
export const prerender = true;
---

<SiteLayout description="Find V4RI on Instagram. Show announcements, records and moments from the booth." title="Socials">
  <header class="v-head"><div><div class="tag dim">§ 04 — socials</div><h1>Elsewhere <em>between sets</em></h1></div><p>Show announcements and a few records along the way.</p></header>
  <div class="page-rule" aria-hidden="true"></div>
  <div class="link-ledger"><div class="link-ledger-row"><span class="tag dim">[ instagram ]</span><div class="destination-block"><p class="destination">@v4ri.wav</p><p class="note">Updates, records and moments from the booth.</p></div><a class="tag" href="https://www.instagram.com/v4ri.wav/">[ follow <span class="red">↗</span> ]</a></div></div>
  <div class="contact-actions tag"><a href="/contact">[ bookings &amp; contact → ]</a><a href="/gigs">[ next shows → ]</a></div>
</SiteLayout>
