---
import { getActivityFeed, getEvents } from "@itsvari/content/astro";
import { canonicalUrl, getEventPhase } from "@itsvari/content";
import ActivityList from "@itsvari/ui/ActivityList.astro";
import EmptyState from "@itsvari/ui/EmptyState.astro";

import SiteLayout from "../layouts/SiteLayout.astro";

const now = new Date();
const [activity, events] = await Promise.all([
  getActivityFeed("v4ri", now),
  getEvents("v4ri", now),
]);
const liveEvent = events.find(
  ({ data }) => data.eventStatus === "scheduled" && getEventPhase(data, now) === "live",
);
const nextEvent = events.find(
  ({ data }) => data.eventStatus === "scheduled" && getEventPhase(data, now) === "upcoming",
);
---

<SiteLayout description="DJ gigs, recorded sets, music releases, and notes from v4ri." title="v4ri.wav">
  <section class="hero">
    <p>DJ / producer</p>
    <h1>v4ri.wav</h1>
    {liveEvent && (
      <p>Live now: <a href={canonicalUrl("event", liveEvent.id, liveEvent.data.canonicalSite)}>{liveEvent.data.title}</a></p>
    )}
    {nextEvent && (
      <p>Next: <a href={canonicalUrl("event", nextEvent.id, nextEvent.data.canonicalSite)}>{nextEvent.data.title}</a></p>
    )}
    {!liveEvent && !nextEvent && <p>No upcoming gigs announced.</p>}
  </section>

  <section class="section">
    <h2>Latest</h2>
    {activity.length > 0 ? <ActivityList currentSite="v4ri" items={activity} /> : <EmptyState />}
  </section>
</SiteLayout>
