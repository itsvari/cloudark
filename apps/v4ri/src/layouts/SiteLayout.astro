---
import "../styles/global.css";
import { siteOrigins } from "@itsvari/content";

interface Props {
  canonical?: URL | string;
  description: string;
  title: string;
}

const { canonical: canonicalProp, description, title } = Astro.props;
const pageTitle = title === "v4ri.wav" ? title : `${title} · v4ri.wav`;
const canonical = canonicalProp ?? new URL(Astro.url.pathname, Astro.site ?? siteOrigins.v4ri).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="v4ri.wav" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="v4ri.wav RSS" href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">v4ri.wav</a>
      <nav aria-label="Primary navigation">
        <a href="/gigs">Gigs</a>
        <a href="/releases">Releases</a>
        <a href="/posts">Posts</a>
        <a href="https://itsvari.com">itsvari.com</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© {new Date().getFullYear()} v4ri</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
