{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "itsvari-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "itsvari.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
