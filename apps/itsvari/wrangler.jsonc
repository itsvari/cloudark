{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "itsvari-com-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "routes": [
    {
      "pattern": "itsvari.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "itsvari-com-website-staging",
      "routes": [],
      "workers_dev": true,
      "preview_urls": true
    }
  }
}
