---
import "../styles/global.css";

interface Props {
  canonical?: URL | string;
  description: string;
  title: string;
}

const { canonical = Astro.url, description, title } = Astro.props;
const pageTitle = title === "itsvari" ? title : `${title} · itsvari`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="alternate" type="application/rss+xml" title="itsvari RSS" href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">itsvari</a>
      <nav aria-label="Primary navigation">
        <a href="/projects">Projects</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="/cv">CV</a>
        <a href="/contact">Contact</a>
        <a href="https://v4ri.wav">v4ri.wav</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Ashe</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
