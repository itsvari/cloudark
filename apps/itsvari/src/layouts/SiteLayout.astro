---
import "@itsvari/ui/styles/tokens.css";
import "@itsvari/ui/styles/base.css";
import "@itsvari/ui/styles/dither.css";
import "@itsvari/ui/styles/motion.css";
import "../styles/global.css";
import { siteOrigins } from "@itsvari/content";
import FontFaces from "@itsvari/ui/FontFaces.astro";
import RegistrationMarks from "@itsvari/ui/RegistrationMarks.astro";
import SectionRail from "@itsvari/ui/SectionRail.astro";
import NavigationDrawer from "@itsvari/ui/NavigationDrawer.astro";
import TouchPress from "@itsvari/ui/TouchPress.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PrimaryNavigation from "../components/PrimaryNavigation.astro";
import { navigation } from "../navigation";

interface Props {
  canonical?: URL | string;
  description: string;
  title: string;
  sections?: string[];
  section?: string;
}
const { canonical: canonicalProp, description, title, sections, section } = Astro.props;
const activePath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentNavigation = navigation.find(({ href }) => href === "/" ? activePath === "/" : activePath.startsWith(href));
const drawerLinks = [...navigation.map((link) => ({ ...link, current: currentNavigation?.href === link.href })), { href: siteOrigins.v4ri, label: "V4RI", external: true }];
const pageIndex = section ?? currentNavigation?.number ?? "00";
const pageTitle = title === "itsvari" ? title : `${title} · itsvari`;
const canonical = canonicalProp ?? new URL(Astro.url.pathname, Astro.site ?? siteOrigins.itsvari).toString();
// faces that set line breaks above the fold are fetched before first paint, so a late swap cannot reflow the page in view.
// labels, headings and their italic asides are on every page; the bitmapped wordmark is on the home page alone.
const earlyFonts = ["departure-mono-regular", "redaction-regular", "redaction-35-italic", ...(activePath === "/" ? ["redaction-50-regular"] : [])];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="itsvari" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {earlyFonts.map((file) => <link rel="preload" href={`/fonts/${file}.woff2`} as="font" type="font/woff2" crossorigin />)}
    {/* a page change waits for the incoming main column, so a view transition never captures a half-parsed page. */}
    <link rel="expect" href="#main" blocking="render" />
    <link rel="alternate" type="application/rss+xml" title="itsvari RSS" href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    {import.meta.env.PROD && process.env.CLOUDFLARE_ENV !== "staging" && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"a1997520d1b8485f98a9a5ada2d8c3c8"}'></script>
    )}
    <FontFaces />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <div class="site-page page">
      <RegistrationMarks position="top" />
      <div class="i-wrap">
        <aside class="i-side">
          <a class="i-brand" href="/" aria-label="itsvari home"><span class="brand-name">itsvari</span><span class="lbl dim">v3.0 · rev. 2026.11</span></a>
          <div class="desktop-navigation"><PrimaryNavigation currentHref={currentNavigation?.href} /></div>
          <NavigationDrawer id="itsvari-navigation" brand="itsvari" links={drawerLinks} collapseAtPx={640} />
          <SiteFooter section={pageIndex} />
        </aside>
        <main class="i-main" id="main" tabindex="-1">
          <span class="i-meta lbl"><span>index · {pageIndex} / 05</span><span>rev. 2026.11</span></span>
          <SectionRail sections={sections ?? [pageIndex]} active={pageIndex} />
          <slot />
          <SiteFooter section={pageIndex} compact />
        </main>
      </div>
      <RegistrationMarks position="bottom" />
    </div>
    <TouchPress />
  </body>
</html>
