---
import "../styles/global.css";
import { siteOrigins } from "@itsvari/content";

interface Props {
  canonical?: URL | string;
  description: string;
  title: string;
}

const { canonical: canonicalProp, description, title } = Astro.props;
const pageTitle = title === "itsvari" ? title : `${title} · itsvari`;
const canonical = canonicalProp ?? new URL(Astro.url.pathname, Astro.site ?? siteOrigins.itsvari).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="itsvari" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="itsvari RSS" href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">itsvari</a>
      <nav aria-label="Primary navigation">
        <a href="/projects">Projects</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="/cv">CV</a>
        <a href="/contact">Contact</a>
        <a href="https://v4ri.wav">v4ri.wav</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Ashe</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
