---
import TableOfContents from "@itsvari/ui/TableOfContents.astro";
import { numberArticleHeadings } from "@itsvari/ui";

interface Props {
  title: string;
  summary: string;
  headings?: { depth: number; slug: string; text: string }[];
  labels?: string[];
  links?: Record<string, string>;
}
const { title, summary, headings = [], labels = [], links = {} } = Astro.props;
const contents = numberArticleHeadings(headings);
---
<article class="reading-article" data-reading-article>
  <div class="page-meta tag">{labels.map((label) => <span>[ {label} ]</span>)}</div>
  <slot name="actions" />
  <h1 class="page-title">{title}</h1>
  <p class="page-lede">{summary}</p>
  <div class="rule" aria-hidden="true"></div>
  <div class:list={["reading-grid", { "without-contents": contents.length === 0 }]}>
    <div class="prose numbered-prose"><slot /></div>
    <TableOfContents headings={headings} />
  </div>
  {Object.keys(links).length > 0 && <div class="reading-links tag">{Object.entries(links).map(([label, href]) => <a href={href}>[ {label} <span class="red">↗</span> ]</a>)}</div>}
</article>
<style>
  .reading-article { min-width: 0; }
  .reading-grid { grid-template-columns: minmax(0, 1fr) minmax(150px, 190px); gap: var(--s-6); }
  .without-contents { grid-template-columns: minmax(0, 1fr); }
  .numbered-prose { counter-reset: article-section; }
  .numbered-prose :global(h2) { counter-increment: article-section; counter-reset: article-subsection; scroll-margin-top: var(--s-9); }
  .numbered-prose :global(h3) { counter-increment: article-subsection; scroll-margin-top: var(--s-9); }
  .numbered-prose :global(h2)::before, .numbered-prose :global(h3)::before { display: block; margin-bottom: var(--s-4); color: var(--dim); font: var(--t-1)/1.4 "Departure Mono", monospace; letter-spacing: .04em; }
  .numbered-prose :global(h2)::before { content: "§ " counter(article-section, decimal-leading-zero); }
  .numbered-prose :global(h3)::before { content: "§ " counter(article-section, decimal-leading-zero) "." counter(article-subsection); }
  @container page (max-width: 1023px) { .reading-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
