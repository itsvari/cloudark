---
import { getPost } from "@itsvari/content/astro";
import { canonicalUrl } from "@itsvari/content";
import { render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ReadingArticle from "../../components/ReadingArticle.astro";
const id = Astro.params.id;
const post = id ? await getPost(id, "itsvari") : undefined;
if (!post) return Astro.rewrite("/404");
const { Content, headings } = await render(post);
const date = new Intl.DateTimeFormat("en-GB", { dateStyle: "long", timeZone: "Asia/Singapore" }).format(post.data.publishedAt);
---
<SiteLayout canonical={canonicalUrl("post", post.id, post.data.canonicalSite)} description={post.data.summary} title={post.data.title}>
  <ReadingArticle title={post.data.title} summary={post.data.summary} headings={headings} labels={[post.data.kind, date, ...post.data.tags]}><Content /></ReadingArticle>
  <div class="reading-links tag"><a href="/blog">[ ← all writing ]</a><a href="/rss.xml">[ subscribe via rss ]</a></div>
</SiteLayout>
