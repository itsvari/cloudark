    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/rss": "^4.0.19",
    "@itsvari/content": "workspace:*",
    "@itsvari/ui": "workspace:*",
    "astro": "^7.4.5"
  }
