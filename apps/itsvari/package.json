{
  "name": "@itsvari/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "pnpm --dir ../.. run build:cloudflare",
    "cf-typegen": "wrangler types",
    "check": "astro check",
