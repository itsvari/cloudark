{
  "name": "cloudark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.23.4 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "build": "pnpm --filter './apps/*' build",
    "build:itsvari": "pnpm --filter @itsvari/web build",
    "build:v4ri": "pnpm --filter @itsvari/music build",
    "build:cloudflare": "pnpm install --frozen-lockfile --strict-peer-dependencies --prod=false && pnpm run audit:dependencies && pnpm run check:media && pnpm run lint && pnpm run check && pnpm run test && pnpm run build && pnpm run check:workers",
    "check": "pnpm --filter './apps/*' check && pnpm --filter @itsvari/ui check && tsc --noEmit -p packages/content/tsconfig.json",
    "check:cloudflare-builds": "node scripts/verify-workers-builds.mjs",
    "check:media": "node scripts/verify-media.mjs",
    "check:staging-access": "node scripts/verify-staging-access.mjs",
    "check:workers": "pnpm --filter @itsvari/web exec wrangler deploy --dry-run && pnpm --filter @itsvari/music exec wrangler deploy --dry-run",
    "dev:itsvari": "pnpm --filter @itsvari/web dev",
    "dev:v4ri": "pnpm --filter @itsvari/music dev",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:dependencies": "pnpm audit && pnpm audit --prod"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
