{
  "name": "cloudark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter './apps/*' build",
    "build:itsvari": "pnpm --filter @itsvari/web build",
    "build:v4ri": "pnpm --filter @itsvari/music build",
    "check": "pnpm --filter './apps/*' check && tsc --noEmit -p packages/content/tsconfig.json",
    "dev:itsvari": "pnpm --filter @itsvari/web dev",
    "dev:v4ri": "pnpm --filter @itsvari/music dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}
