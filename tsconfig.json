{
  "compilerOptions": {
    "allowJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": [
    "**/.astro/**",
    "**/.wrangler/**",
    "**/dist/**",
    "**/node_modules/**"
  ]
}
